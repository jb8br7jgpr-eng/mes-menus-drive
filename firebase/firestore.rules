// OBSOLETE: prototype V34 multi-comptes, ne pas publier.
// La nouvelle architecture utilise firebase/firestore-cloud-first.rules.

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // V34 PREPARATION. Do not publish until account/join testing is ready.
    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function householdPath(hid) {
      return /databases/$(database)/documents/households/$(hid);
    }
    function owner(hid) {
      return verified() &&
        exists(householdPath(hid)) &&
        get(householdPath(hid)).data.ownerUid == request.auth.uid;
    }
    function member(hid) {
      return owner(hid) ||
        (verified() &&
         exists(/databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid)));
    }
    function keyRegistry(hid, key) {
      return /databases/$(database)/documents/households/$(hid)/uniqueKeys/$(key);
    }
    function recordedKeyCreate(hid, rid, d) {
      return (d.kind in ['product','ingredient'] &&
        d.uniqueKey is string && d.uniqueKey.size() < 550 &&
        getAfter(keyRegistry(hid, d.uniqueKey)).data.recordId == rid &&
        getAfter(keyRegistry(hid, d.uniqueKey)).data.kind == d.kind) ||
        (!(d.kind in ['product','ingredient']) && d.uniqueKey == null);
    }
    function validRecordCreate(hid, rid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id','kind','payload','uniqueKey','version','deleted','createdAt','createdBy','updatedAt','updatedBy','lastMutationId'])
        && d.keys().hasAll(['id','kind','payload','uniqueKey','version','deleted','createdAt','createdBy','updatedAt','updatedBy','lastMutationId'])
        && d.id == rid
        && d.kind in ['recipe','recipePhoto','product','ingredient','staple','weekMeta','weekMeal','weekExtra','weekChecked','weekExcluded','weekPantry','weekPantryUnit','settings','preference']
        && d.payload is map
        && recordedKeyCreate(hid, rid, d)
        && d.lastMutationId is string
        && d.lastMutationId.size() > 0
        && d.lastMutationId.size() <= 100
        && d.version == 1
        && d.deleted == false
        && d.createdAt == request.time
        && d.updatedAt == request.time
        && d.createdBy == request.auth.uid
        && d.updatedBy == request.auth.uid;
    }
    function validRecordUpdate(rid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id','kind','payload','uniqueKey','version','deleted','createdAt','createdBy','updatedAt','updatedBy','lastMutationId'])
        && d.keys().hasAll(['id','kind','payload','uniqueKey','version','deleted','createdAt','createdBy','updatedAt','updatedBy','lastMutationId'])
        && d.id == rid
        && d.id == resource.data.id
        && d.kind == resource.data.kind
        && d.uniqueKey == resource.data.uniqueKey
        && d.createdAt == resource.data.createdAt
        && d.createdBy == resource.data.createdBy
        && d.payload is map
        && d.deleted is bool
        && d.lastMutationId is string
        && d.lastMutationId.size() > 0
        && d.lastMutationId.size() <= 100
        && d.lastMutationId != resource.data.lastMutationId
        && d.version == resource.data.version + 1
        && d.updatedAt == request.time
        && d.updatedBy == request.auth.uid;
    }

    match /userProfiles/{uid} {
      // Server-side household pointer: never rely on a phone-only code.
      allow get: if verified() && request.auth.uid == uid;
      allow list: if false;
      allow create, update: if verified() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['householdId','updatedAt'])
        && request.resource.data.keys().hasAll(['householdId','updatedAt'])
        && request.resource.data.householdId is string
        && request.resource.data.householdId.size() <= 100
        && (member(request.resource.data.householdId) ||
          getAfter(householdPath(request.resource.data.householdId)).data.ownerUid == request.auth.uid)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /households/{hid} {
      allow get: if member(hid);
      allow list: if false;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['ownerUid','name','createdAt'])
        && request.resource.data.keys().hasAll(['ownerUid','name','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && request.resource.data.createdAt == request.time;
      allow update: if owner(hid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80;
      allow delete: if false;

      match /members/{uid} {
        allow get: if owner(hid) || (verified() && request.auth.uid == uid);
        allow list: if owner(hid);
        // Only the owner adds another user by their exact Firebase UID.
        allow create: if owner(hid)
          && uid != request.auth.uid
          && request.resource.data.keys().hasOnly(['uid','role','createdAt'])
          && request.resource.data.keys().hasAll(['uid','role','createdAt'])
          && request.resource.data.uid == uid
          && request.resource.data.role == 'member'
          && request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if owner(hid) && uid != request.auth.uid;
      }

      match /uniqueKeys/{key} {
        allow get: if member(hid);
        allow list: if false;
        // A uniqueness reservation is created atomically alongside its record.
        allow create: if member(hid)
          && request.resource.data.keys().hasOnly(['key','kind','recordId','createdAt','createdBy'])
          && request.resource.data.keys().hasAll(['key','kind','recordId','createdAt','createdBy'])
          && request.resource.data.key == key
          && request.resource.data.kind in ['product','ingredient']
          && request.resource.data.recordId is string
          && request.resource.data.createdAt == request.time
          && request.resource.data.createdBy == request.auth.uid
          && getAfter(/databases/$(database)/documents/households/$(hid)/records/$(request.resource.data.recordId)).data.uniqueKey == key;
        allow update, delete: if false;
      }

      match /records/{rid} {
        allow get, list: if member(hid);
        allow create: if member(hid) && validRecordCreate(hid, rid);
        allow update: if member(hid) && validRecordUpdate(rid);
        // Soft deletion preserves a recoverable tombstone/version.
        allow delete: if false;
      }
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
